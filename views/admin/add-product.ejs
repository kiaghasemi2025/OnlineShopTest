<%- include('../includes/head.ejs') %>
<%- include('../includes/header.ejs') %>
<%- include('../includes/navigation.ejs') %>

    <main>
  <% if(hasError) { %>
  <% if(errorMessage) { %>
  <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
  <% } %>
  <% } %>
  <div class="container"> 
    <form  action="/admin/<% if (editing) { %>edit-product<% } else { %>add-product<%}%>" method="post" class="form-example" novalidate enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="title">عنوان</label>
        <input
          type="text"
          class="form-control <%= validatinError.find(a => a.path === 'title') ? 'alert-danger' : '' %>"
          name="title"
          placeholder="نام محصول را وارد کنید"
          id="title" 
          required value="<% if(editing || hasError) { %> <%= product.title %> <% } %>"
        />
      </div>
      <div class="form-group">
        <label for="title">قیمت</label>
        <input
          type="number"
          class="form-control <%= validatinError.find(a => a.path === 'price') ? 'alert-danger' : '' %>"
          id="price"
          name="price"
          placeholder="قیمت محصول را وارد کنید"
          required value="<% if(editing || hasError) { %><%=product.price%><% } %>"
        />
      </div>
      <div class="form-group">
        <label for="title">آدرس عکس</label>
        <input
          type="file"
          class="form-control"
          id="image"
          name="image"
          placeholder="عکس محصول را وارد کنید"
        />
      </div>
      <div class="form-group">
        <label for="title">توضیحات</label>
        <textarea
          class="form-control <%= validatinError.find(a => a.path === 'description') ? 'alert-danger' : '' %>"
          name="description"
          cols="30"
          rows="10"
        ><%if(editing || hasError){%><%=product.description%><%}%></textarea>
      </div>
      <% if(editing) { %>
      <input type="hidden" value="<%= product._id %>" name="productId">
      <% } %>
      <button type="submit" class="btn btn-primary"><% if(editing) { %>ویرایش محصول<% } else { %> افزودن محصول<%}%></button>
    </form>
  </div>
</main>

<%- include('../includes/end.ejs') %>