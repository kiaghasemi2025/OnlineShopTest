<% if (isAuthenticated) { %>
<form action="/cart" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="btn btn-dark">
        افزودن به سبدخرید
    </button>
    <input type="hidden" name="productId" value="<%= product._id %>">
</form>
<% } %>