
<%- include('../includes/head.ejs') %>

<section class="vh-100" style="background-color: #5072fc">
    <% if(errorMassage) { %>
  <div class="alert alert-danger" role="alert"><%= errorMassage %></div>
  <% } %>
    <% if(successMassage) { %>
  <div class="alert alert-success" role="alert"><%= successMassage %></div>
  <% } %>

    <div class="container py-5 h-100">
      <div class="row d-flex justify-content-center align-items-center h-100">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
          <div class="card shadow-2-strong" style="border-radius: 1rem">
            <div class="card-body p-5 text-center">
              <h3 class="mb-5">ورود</h3>
              <form action="/login" method="post" novalidate>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-outline mb-4">
                    <input 
                        value="<%= oldInput.email %>" 
                        name="email" 
                        type="email" 
                        id="typeEmailX-2" 
                        class="form-control form-control-lg <%= validatinError.find(a => a.path === 'email') ? 'alert-danger' : '' %>" 
                        placeholder="نام کاربری یا ایمیل خود را وارد کنید">
                  </div>
                  <div class="form-outline mb-4">
                    <input 
                        value="<%= oldInput.password %>"  
                        name="password"  
                        type="password" 
                        id="typePasswordX-2" 
                        class="form-control form-control-lg <%= validatinError.find(a => a.path === 'password') ? 'alert-danger' : '' %>" 
                        placeholder="رمز عبور را وارد کنید">
                  </div>
                  <button class="btn btn-primary btn-lg btn-block" type="submit">
                    وارد شوید
                  </button>
                  <hr>
                  <div>
                    <a href="resetpass">فراموشی رمز عبور</a>
                  </div>
              </form>
           
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

<%- include('../includes/end.ejs') %>



