<%- include('../includes/head.ejs') %>

<section class="vh-100" style="background-color: #5072fc">
  <% if(errorMessage[0]) { %>
  <div class="alert alert-danger" role="alert"><%= errorMessage[0] %></div>
  <% } %>
    <div class="container py-5 h-100">
      <div class="row d-flex justify-content-center align-items-center h-100">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
          <div class="card shadow-2-strong" style="border-radius: 1rem">
            <div class="card-body p-5 text-center">
              <h3 class="mb-5">بازیابی رمز عبور</h3>
              <form action="/resetpass" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-outline mb-4">
                    <input name="email" type="email" id="typeEmailX-2" class="form-control form-control-lg" placeholder="ایمیل">
                  </div>
                  <button class="btn btn-primary btn-lg btn-block" type="submit">
                   ارسال رمز عبور
                  </button>
              </form>
           
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

<%- include('../includes/end.ejs') %>



